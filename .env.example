# Discord
DISCORD_TOKEN=your_discord_bot_token

# Google Cloud Storage (where sounds/users/memory/resources live)
BUCKET_PATH=your-gcs-bucket-name
# Path to a service-account JSON file with read/write access to the bucket
GOOGLE_APPLICATION_CREDENTIALS=./gcp-credentials.json
# Optional GCS overrides
PROJECT_ID=
BUCKET_SUB_NAME=

# OpenWebUI / Ollama (powers chat, persona, conversation AI)
OPENWEBUI_URL=http://localhost:8080
OPENWEBUI_API_KEY=your_openwebui_api_key

# SearXNG instance for the !img command. Optional - omit to disable image search.
SEARXNG_URL=

# Local cache directory for assets pulled from the bucket
DATA_DIR=./data
